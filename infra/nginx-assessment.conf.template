# Served by BOTH deployment stacks — production (docker-compose.yml, the
# `gateway` service / `shizi-gateway` container, behind
# shizi.realxco.com) and dev (docker-compose.dev.yml, `gateway-dev` /
# `shizi-gateway-dev`, behind shizi-dev.realxco.com). This is a
# TEMPLATE, not a finished config: it's mounted at
# /etc/nginx/templates/default.conf.template, where the stock
# nginx:alpine entrypoint runs `envsubst` over it at container start and
# writes the result to /etc/nginx/conf.d/default.conf.
#
# The ONLY thing that differs between the two environments is the single
# SYNC_UPSTREAM placeholder below — each gateway must reach its OWN sync
# service (`sync` in prod, `sync-dev` in dev). Named without the
# dollar-brace syntax deliberately, even here in a comment: envsubst
# rewrites comments too, and a substituted mention would make the two
# rendered configs differ in two places instead of one, muddying the
# parity check this template exists to make crisp. Everything else is
# byte-identical: a dev gateway whose routing has drifted from prod's
# stops being evidence about prod, which defeats the point of having it.
# That's why this is one shared template rather than two config files —
# see add-dev-deployment's design.md, "One nginx config, rendered per
# stack".
#
# Both compose files set NGINX_ENVSUBST_FILTER to match ONLY
# SYNC_UPSTREAM. Without that filter, envsubst substitutes every defined
# environment variable, and nginx's own runtime variables below —
# $host, $scheme, $remote_addr, $proxy_add_x_forwarded_for — share
# envsubst's syntax exactly. An unfiltered pass would blank any of them
# that happened to collide with a container env var. Verify with:
#   docker exec shizi-gateway cat /etc/nginx/conf.d/default.conf

server {
    listen       80;
    listen  [::]:80;
    server_name  localhost;

    # shizi.realxco.com is a single "holding service" — this one nginx
    # container is the only thing the Cloudflare Tunnel needs to point at.
    # The app lives under /assessment/ (matching vite.config.ts's `base`) so
    # a future second app can live at another path prefix on the same
    # container/hostname without needing a second tunnel target. Visiting
    # the bare domain root sends you straight to the one app that exists.
    location = / {
        return 302 /assessment/;
    }

    # nginx's prefix matching on `location /assessment/` requires the
    # trailing slash literally — a request for the bare `/assessment` (no
    # slash, the natural way to type this URL) matches no location block at
    # all and 404s otherwise. Redirect it to the slash form explicitly.
    location = /assessment {
        return 301 /assessment/;
    }

    # `alias`, not `root`: it strips the /assessment/ location prefix before
    # looking the file up on disk, since the built files live at this
    # container's html root (docker-compose.yml's volume mount), not nested
    # under an extra assessment/ subdirectory on disk.
    location /assessment/ {
        alias  /usr/share/nginx/html/;
        index  index.html index.htm;
    }

    # Stock nginx:alpine's mime.types doesn't include .webmanifest, so it
    # falls back to application/octet-stream — same fix as
    # spikes/nginx-default.conf, just aliased to the one manifest file.
    location = /assessment/manifest.webmanifest {
        alias  /usr/share/nginx/html/manifest.webmanifest;
        default_type application/manifest+json;
    }

    # A cached service-worker file is a real PWA-correctness bug, not just a
    # performance nicety: if sw.js itself is cached, a new build can never
    # reach the device, no matter how the app's own precache manifest is
    # versioned. Browsers already avoid caching this aggressively, but
    # nginx's default static-file headers don't set this explicitly — make
    # it explicit rather than rely on that.
    location = /assessment/sw.js {
        alias  /usr/share/nginx/html/sw.js;
        add_header Cache-Control "no-cache";
    }

    # Nested under /assessment/ (not a sibling top-level /sync) so this
    # app's whole footprint — static files and its sync endpoint — stays
    # self-contained under one path prefix; a future second app gets its own
    # prefix with no risk of collision. Same-origin (no CORS to configure).
    # The trailing slashes on both the location and proxy_pass matter: they
    # strip the /assessment/sync prefix, so /assessment/sync/events reaches
    # the sync service as /events.
    location /assessment/sync/ {
        proxy_pass http://${SYNC_UPSTREAM}:8787/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
