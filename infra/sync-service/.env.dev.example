# The dev deployment's shared token (add-dev-deployment). MUST NOT be the
# same value as production's SYNC_SHARED_TOKEN in infra/sync-service/.env
# — a token shared across environments would mean a leak of the dev
# token (a deliberately lower-stakes, disposable environment) also
# compromises production. Generate a separate one:
#   openssl rand -hex 32
# Must match VITE_SYNC_TOKEN in apps/assessment/.env.dev.
SYNC_SHARED_TOKEN=

# The rest have working defaults (see src/server.ts) and don't need to be
# set for local/docker-compose use — override only if you need to.
# PORT=8787
# EVENTS_DB_PATH=./data/events.sqlite
# BACKUP_DIR=./data/backups
