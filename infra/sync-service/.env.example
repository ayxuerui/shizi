# Required — the server refuses to start without this (task 9.3's
# shared-token auth). Generate a real one with, e.g.:
#   openssl rand -hex 32
# Must match VITE_SYNC_TOKEN in apps/assessment/.env.
SYNC_SHARED_TOKEN=

# The rest have working defaults (see src/server.ts) and don't need to be
# set for local/docker-compose use — override only if you need to.
# PORT=8787
# EVENTS_DB_PATH=./data/events.sqlite
# BACKUP_DIR=./data/backups
