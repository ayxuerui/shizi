{
  "$schema": "https://opencode.ai/config.json",

  // Strong price/performance default for implementation work.
  "model": "anthropic/claude-sonnet-5",

  // Economical model for titles, summaries, and lightweight tasks.
  "small_model": "openai/gpt-5.6-luna",

  "agent": {
    "plan": {
      "model": "anthropic/claude-opus-5",
      "variant": "max"
    },
    "build": {
      "model": "anthropic/claude-sonnet-5",
      "variant": "high"
    }
  }
}
