# Dev deployment build config (add-dev-deployment). Build with:
#   npm run build --workspace=apps/assessment -- --mode dev
# which loads THIS file (Vite's per-mode convention: `.env.<mode>`) —
# copy it to `.env.dev` first, same as `.env.example` -> `.env`.

# Drives vite.config.ts's PWA manifest name ("shizi dev" instead of
# "shizi") and src/components/EnvBadge.tsx's on-screen marker. NOT Vite's
# own `mode` — see vite.config.ts's header comment for why a separate,
# explicit flag is used instead of overloading `mode`.
VITE_APP_ENV=dev

# Same relative same-origin path as prod's default — dev has its own
# hostname/origin (shizi-dev.realxco.com), so the relative path still
# resolves to THIS deployment's own sync service, not prod's.
VITE_SYNC_ENDPOINT=/assessment/sync
# Must match the dev sync service's SYNC_SHARED_TOKEN
# (infra/sync-service/.env.dev) — and must NOT be the same value as
# prod's apps/assessment/.env token (specs/deployment/spec.md: "a
# credential leaked from one environment does not open the other").
VITE_SYNC_TOKEN=
